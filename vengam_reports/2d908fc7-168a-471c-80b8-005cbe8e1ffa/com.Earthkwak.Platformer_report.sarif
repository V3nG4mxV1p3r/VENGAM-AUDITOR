{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "VENGAM Auditor",
          "version": "7.0.0",
          "informationUri": "https://github.com/vengam/gamesec",
          "rules": [
            {
              "id": "ExposedHighEntropyUnknownAsset",
              "name": "Exposed High-Entropy Unknown Asset",
              "shortDescription": {
                "text": "Exposed High-Entropy Unknown Asset"
              },
              "fullDescription": {
                "text": "High Shannon entropy string detected near security-sensitive keyword."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "general"
                ],
                "precision": "high",
                "security-severity": "9.8"
              }
            },
            {
              "id": "DebugGodModeFlag",
              "name": "Debug / God Mode Flag",
              "shortDescription": {
                "text": "Debug / God Mode Flag"
              },
              "fullDescription": {
                "text": "Debug gameplay flags (god mode, infinite resources) found. May be activatable at runtime."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "anticheat"
                ],
                "precision": "medium",
                "security-severity": "7.5"
              }
            },
            {
              "id": "UnclassifiedHighEntropyAsset",
              "name": "Unclassified High-Entropy Asset",
              "shortDescription": {
                "text": "Unclassified High-Entropy Asset"
              },
              "fullDescription": {
                "text": "High Shannon entropy string detected near security-sensitive keyword."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "general"
                ],
                "precision": "low",
                "security-severity": "5.0"
              }
            },
            {
              "id": "InsecureRandomNumberGenerator",
              "name": "Insecure Random Number Generator",
              "shortDescription": {
                "text": "Insecure Random Number Generator"
              },
              "fullDescription": {
                "text": "java.util.Random or Math.random() used in a security context — not cryptographically secure."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "security",
                  "general"
                ],
                "precision": "medium",
                "security-severity": "2.0"
              }
            }
          ]
        }
      },
